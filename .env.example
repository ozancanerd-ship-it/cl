# Beispiel-Umgebungsdatei. NUR Platzhalter-Namen, NIEMALS echte Werte committen.
# Lokale Kopie als `.env` anlegen (ist in .gitignore ausgeschlossen).
#
# In Phase 1 (Data Foundation) wird KEINE dieser Variablen benötigt – die gesamte
# Daten-Pipeline läuft lokal ohne Accounts, Keys oder Netzwerkzugriff.
# Broker-/Exchange-Zugangsdaten kommen frühestens in Phase 9 (Bybit Testnet) und dann
# ausschließlich über Umgebungsvariablen / OS-Keychain – NIE in dieser Datei, NIE im Repo.

# Laufzeitmodus: development | research | backtest | paper | demo   (live NICHT zulässig)
TRADING_AGENT_MODE=development

# Pfad zur lokalen Hauptkonfiguration
TRADING_AGENT_CONFIG=config/config.yaml

# Logging: DEBUG | INFO | WARNING | ERROR
TRADING_AGENT_LOG_LEVEL=INFO

# --------------------------------------------------------------------------------------------
# Exchange-Account-Zugang — NUR READ-ONLY. Werte NIE hier eintragen, nur in der lokalen `.env`
# (chmod 600) oder im macOS-Keychain (security add-generic-password -s trading-agent -a <NAME> -w).
# --------------------------------------------------------------------------------------------
#
# Kraken — API-Key mit AUSSCHLIESSLICH Query-Rechten:
#   Query funds / Query open orders & trades / Query closed orders & trades / Query ledger entries
#   NICHT: Create & modify orders, Cancel/close orders, Deposit, Withdraw, WebSocket, Subaccounts
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
#
# Bybit — API-Key im Modus "Read-Only" (Bybit EU: Host api.bybit.eu):
#   Lesezugriff auf Wallet / Positions / Orders / Trade-History genügt.
#   NICHT: Unified Trading (Trade), Spot Trade, Derivatives Trade, Copy Trading, Withdraw, Transfer
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
#
# cTrader / Pepperstone — OAuth2, Scope "accounts" (nur lesen, KEIN "trading"-Scope):
#   CLIENT_ID/SECRET von der App-Registrierung auf https://openapi.ctrader.com.
#   ACCESS_TOKEN/REFRESH_TOKEN/ACCOUNT_ID setzt  scripts/ctrader_link.py  automatisch.
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=
# CTRADER_ACCESS_TOKEN=
# CTRADER_REFRESH_TOKEN=
# CTRADER_ACCOUNT_ID=
# CTRADER_ENV=demo
#
# Binance — API-Key mit AUSSCHLIESSLICH "Enable Reading":
#   NICHT: Enable Spot & Margin Trading, Enable Futures, Enable Withdrawals,
#          Permit Universal Transfer, Enable Internal Transfer
#   (Öffentliche Marktdaten inkl. XAUUSDT-Futures brauchen KEINEN Key.)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
