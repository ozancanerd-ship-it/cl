# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtuelle Umgebungen
.venv/
venv/
env/

# Test / Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Lokale Konfiguration (nur *.example.* wird versioniert)
config/*.yaml
!config/*.example.yaml
config/*.yml
!config/*.example.yml

# Ausnahmen: enthalten KEINE Secrets, sind aber tragende Konfiguration und muessen
# eine Historie haben. risk.yaml ist seit dem Verzicht auf den statistischen Beweis
# das gesamte Sicherheitsnetz (siehe Kopf der Datei) — eine Aenderung daran ohne
# nachvollziehbaren Commit waere genau die Art Drift, die man spaeter nicht mehr findet.
!config/risk.yaml
!config/costs.yaml

# Echtes Depot: Ozans Positionen. Bleibt lokal, das Repo ist oeffentlich.
config/holdings_trade_republic.json

# Secrets / Umgebung (NIE committen)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Lokale Daten (Marktdaten, Repository, State, Journal) – nie versioniert
data/raw/*
data/processed/*
data/journal/*
data/repository/*
data/repository_real/*
# Ausnahme: das Forward-Journal ist die einzige unkontaminierte Datenspur, die das
# Projekt noch erzeugt (docs/TSMOM-MULTIASSET-ERGEBNIS-2026-09-04.md). Es ist klein,
# es waechst um eine Zeile am Tag, und es darf nicht nur auf einem Rechner liegen.
!data/repository_real/live/
data/repository_real/live/*
!data/repository_real/live/tsmom_forward.jsonl
!data/repository_real/live/tsmom_forward_corrections.jsonl
# Der Alarm-Verlauf (alerts.jsonl) — bis 28.09. NICHT hier gelistet und deshalb bei
# jedem CI-Lauf leer, obwohl scan_alert.py brav in sie schreibt: eine frische Ubuntu-VM
# hat keine Datei, die nie committet wurde. Die Folge: die "Alarme"-Seite in der App
# zeigte praktisch nie echten Verlauf, egal wie viele Alarme tatsaechlich rausgingen —
# und genau das sah fuer Ozan aus wie "seit Tagen kommt nichts". FileSink kappt sie
# jetzt selbst (max_zeilen), also waechst sie nicht unbegrenzt im Repo.
!data/repository_real/live/alerts.jsonl
# NICHT freigegeben: echter Depotstand.
data/repository_real/live/portfolio_snapshot.json
data/cache/*
data/state/*
data/research/*
!data/**/.gitkeep

# Dashboard-Snapshot enthält echte Portfolio-Zahlen – nur lokal
web/dashboard.json

# uv.lock WIRD versioniert (reproduzierbare Umgebung) – NICHT ignorieren.

# Editor / OS
.idea/
.vscode/
.DS_Store

# Logs
*.log
logs/

# Generierte Diagnose-Artefakte (Script bleibt versioniert, Output nicht)
diagnostics/

# Die Web-App wird bei jedem Lauf neu erzeugt — nur die Vorlage gehoert ins Repo.
web/plan.json
web/scan.json
web/asset/
web/watchlist.json
web/macro.json
web/waechter.json
web/performance.json
web/fundamentals.json
web/aktien_info.json
web/preview.html
web/artifact_snapshot.html
_site/
